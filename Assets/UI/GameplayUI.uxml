<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd">
    
    <ui:Style src="GameplayUI.uss" />

    <ui:VisualElement class="gameplay-container">
        <ui:VisualElement class="top-bar">
            <ui:VisualElement class="player-panels">
                <ui:VisualElement name="player-panel-0" class="player-panel player-panel--p1">
                    <ui:Label text="Player 1" class="player-panel-name" />
                    <ui:VisualElement name="player-panel-balls-0" class="player-panel-balls" />
                    <ui:Label name="player-panel-open-0" text="Open table" class="player-panel-open" />
                </ui:VisualElement>
                <ui:VisualElement name="player-panel-1" class="player-panel player-panel--p2">
                    <ui:Label text="Player 2" class="player-panel-name" />
                    <ui:VisualElement name="player-panel-balls-1" class="player-panel-balls" />
                    <ui:Label name="player-panel-open-1" text="Open table" class="player-panel-open" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Compact cue ball button — always visible in top-right -->
            <ui:VisualElement name="spin-button" class="spin-button">
                <!-- Hit position indicator dot -->
                <ui:VisualElement name="spin-button-dot" class="spin-button-dot" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="bottom-bar" class="bottom-bar">
            <ui:VisualElement class="lock-toggles">
                <ui:Button name="lock-aim-toggle" class="hud-button lock-button--aim">
                    <ui:VisualElement class="lock-badge" />
                </ui:Button>
                <ui:Button name="lock-power-toggle" class="hud-button lock-button--power">
                    <ui:VisualElement class="lock-badge" />
                </ui:Button>
            </ui:VisualElement>

            <ui:Button name="shoot-button" class="hud-button shoot-button">
                <ui:VisualElement class="lock-badge" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Expanded spin panel — absolute overlay, anchored top-right, hidden by default -->
    <ui:VisualElement name="spin-panel" class="spin-panel spin-panel--hidden">
        <!-- Cue ball face the player drags on -->
        <ui:VisualElement name="spin-ball" class="spin-ball">
            <!-- Ball shine highlights -->
            <ui:VisualElement class="spin-ball-shine" />
            <!-- Draggable hit-point indicator -->
            <ui:VisualElement name="spin-hit-dot" class="spin-hit-dot" />
        </ui:VisualElement>
        <ui:Label class="spin-panel-label" text="Hit Point" />
    </ui:VisualElement>

    <!-- Turn-change announcement — absolute overlay, hidden by default -->
    <ui:Label name="turn-banner" text="Player 1's Turn" class="turn-banner turn-banner--hidden" />

    <!-- Denied-shoot hint — absolute overlay above the bottom bar, hidden by default -->
    <ui:Label name="shoot-hint" text="Drag back from the cue ball to set power" class="shoot-hint shoot-hint--hidden" />

    <!-- Game-over result — full-screen overlay, hidden by default -->
    <ui:VisualElement name="game-over" class="game-over game-over--hidden">
        <ui:VisualElement class="game-over-panel">
            <ui:Label name="game-over-title" text="Player 1 Wins" class="game-over-title" />
            <ui:VisualElement class="game-over-buttons">
                <ui:Button name="game-over-play-again" text="Play Again" class="game-over-button" />
                <ui:Button name="game-over-menu" text="Menu" class="game-over-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
