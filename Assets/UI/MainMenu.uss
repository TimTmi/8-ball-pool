.main-container {
    flex-grow: 1;
    background-color: rgb(34, 139, 34); /* Pool table green */
}

.view-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    position: absolute;
}

.title-label {
    font-size: 80px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 50px;
}

.menu-button {
    font-size: 40px;
    width: 300px;
    height: 80px;
    margin-bottom: 20px;
    background-color: rgb(200, 200, 200);
    border-radius: 10px;
    color: black;
}

.menu-button:hover {
    background-color: white;
}

.credits-text {
    font-size: 30px;
    color: white;
    margin-bottom: 10px;
    -unity-font-style: bold;
}

.subtitle-label {
    font-size: 48px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 40px;
}

.rules-list {
    width: 640px;
}

.rule-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.rule-text {
    flex-grow: 1;
    margin-right: 24px;
}

.rule-name {
    font-size: 30px;
    color: white;
    -unity-font-style: bold;
}

.rule-description {
    font-size: 20px;
    color: rgb(220, 220, 220);
    margin-top: 4px;
}
