.main-container {
    flex-grow: 1;
    background-color: rgb(16, 45, 28);
}

.backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.glow-ring {
    position: absolute;
    border-radius: 500px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.05);
    background-color: rgba(255, 255, 255, 0.02);
}

.glow-ring--large {
    width: 900px;
    height: 900px;
    top: -320px;
    right: -260px;
}

.glow-ring--small {
    width: 520px;
    height: 520px;
    bottom: -180px;
    left: -160px;
}

.rack {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    align-items: center;
    opacity: 0.95;
    display: none;
}

.rack-row {
    flex-direction: row;
}

.rack-row--rest {
    margin-top: -10px;
}

.rack-ball {
    width: 44px;
    height: 44px;
    margin: 0 1px;
    -unity-background-scale-mode: scale-to-fit;
}

.rack-ball--1 {
    background-image: resource("Sprites/Ball_01");
}

.rack-ball--2 {
    background-image: resource("Sprites/Ball_02");
}

.rack-ball--3 {
    background-image: resource("Sprites/Ball_03");
}

.rack-ball--4 {
    background-image: resource("Sprites/Ball_04");
}

.rack-ball--5 {
    background-image: resource("Sprites/Ball_05");
}

.rack-ball--6 {
    background-image: resource("Sprites/Ball_06");
}

.rack-ball--7 {
    background-image: resource("Sprites/Ball_07");
}

.rack-ball--8 {
    background-image: resource("Sprites/Ball_08");
}

.rack-ball--9 {
    background-image: resource("Sprites/Ball_09");
}

.rack-ball--10 {
    background-image: resource("Sprites/Ball_10");
}

.rack-ball--11 {
    background-image: resource("Sprites/Ball_11");
}

.rack-ball--12 {
    background-image: resource("Sprites/Ball_12");
}

.rack-ball--13 {
    background-image: resource("Sprites/Ball_13");
}

.rack-ball--14 {
    background-image: resource("Sprites/Ball_14");
}

.rack-ball--15 {
    background-image: resource("Sprites/Ball_15");
}

.view-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    position: absolute;
}

.menu-view {
    padding-bottom: 150px;
}

.title-block {
    align-items: center;
    margin-bottom: 56px;
}

.title-label {
    font-size: 68px;
    -unity-font-style: bold;
    color: white;
    letter-spacing: 4px;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.45);
}

.title-subtitle {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 8px;
    margin-top: 12px;
    display: none;
}

.menu-button {
    font-size: 32px;
    -unity-font-style: bold;
    width: 340px;
    height: 84px;
    margin-bottom: 18px;
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 42px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.18);
    color: white;
    letter-spacing: 2px;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
}

.menu-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.55);
    scale: 1.04 1.04;
}

.menu-button:active {
    scale: 0.97 0.97;
}

.menu-button--primary {
    background-color: rgb(70, 200, 90);
    border-color: rgb(70, 200, 90);
    color: rgb(12, 32, 16);
}

.menu-button--primary:hover {
    background-color: rgb(88, 218, 108);
    border-color: rgb(88, 218, 108);
}

.credits-panel {
    align-items: center;
    background-color: rgba(15, 15, 15, 0.7);
    border-radius: 24px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 40px 64px;
}

.credits-title {
    font-size: 48px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 28px;
}

.credits-text {
    font-size: 28px;
    color: white;
    margin-bottom: 12px;
    -unity-font-style: bold;
}

.credits-back-button {
    width: 260px;
    margin-top: 32px;
    margin-bottom: 0;
}

.modal-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.modal-panel {
    width: 720px;
    background-color: rgba(15, 15, 15, 0.961);
    border-radius: 24px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 40px 48px;
}

.modal-title {
    font-size: 48px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    margin-bottom: 32px;
}

.modal-primary-button {
    width: 100%;
    margin-top: 32px;
    margin-bottom: 12px;
    background-color: rgb(34, 139, 34);
    color: white;
}

.modal-primary-button:hover {
    background-color: rgb(42, 165, 42);
}

.modal-secondary-button {
    width: 100%;
    margin-bottom: 0;
    background-color: rgba(255, 255, 255, 0.08);
    color: white;
}

.modal-secondary-button:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.rules-list {
    width: 100%;
}

.rule-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.rule-text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-right: 24px;
}

.rule-name {
    font-size: 30px;
    color: white;
    -unity-font-style: bold;
}

.rule-description {
    font-size: 20px;
    color: rgb(220, 220, 220);
    margin-top: 4px;
    white-space: normal;
}
