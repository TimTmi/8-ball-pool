/* ── Layout ─────────────────────────────────────────────────── */

.gameplay-container {
    flex-grow: 1;
    justify-content: space-between;
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 20px;
}

.turn-label {
    font-size: 30px;
    -unity-font-style: bold;
    color: white;
}

/* ── Compact spin button (always-visible cue ball) ──────────── */

.spin-button {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: rgb(240, 240, 235);
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0.35);
    align-items: center;
    justify-content: center;
    -unity-overflow-clip-box: padding-box;
}

.spin-button:hover {
    background-color: rgb(255, 255, 250);
    border-color: rgba(0, 0, 0, 0.55);
    scale: 1.06 1.06;
}

/* Small dot showing current hit position inside the compact button */
.spin-button-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgba(30, 30, 30, 0.85);
    position: absolute;
}

/* ── Expanded spin panel overlay ────────────────────────────── */

.spin-panel {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: rgba(15, 15, 15, 0.82);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 16px;
    align-items: center;
}

.spin-panel--hidden {
    display: none;
}

/* Large interactive cue ball */
.spin-ball {
    width: 200px;
    height: 200px;
    border-radius: 100px;
    background-color: rgb(240, 240, 235);
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0.3);
    overflow: hidden;
}

/* Shine highlight — small off-centre ellipse */
.spin-ball-shine {
    position: absolute;
    width: 60px;
    height: 40px;
    border-radius: 30px;
    background-color: rgba(255, 255, 255, 0.55);
    top: 20px;
    left: 30px;
}

/* Draggable hit-point dot on the large ball */
.spin-hit-dot {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: rgba(20, 20, 20, 0.85);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.5);
    position: absolute;
}

/* "Hit Point" label below the ball */
.spin-panel-label {
    color: rgba(220, 220, 220, 0.9);
    font-size: 18px;
    margin-top: 10px;
    -unity-font-style: bold;
}

/* ── Bottom bar ─────────────────────────────────────────────── */

.bottom-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding: 20px;
}

.lock-toggles {
    background-color: rgba(0, 0, 0, 0.5);
    padding: 10px;
    border-radius: 10px;
}

.lock-toggles > Toggle {
    color: white;
    font-size: 20px;
}

.shoot-button {
    width: 150px;
    height: 80px;
    font-size: 30px;
    -unity-font-style: bold;
    background-color: rgb(200, 50, 50);
    color: white;
    border-radius: 40px;
}

.shoot-button:hover {
    background-color: rgb(255, 50, 50);
}

