/* ── Layout ─────────────────────────────────────────────────── */

.gameplay-container {
    flex-grow: 1;
    justify-content: space-between;
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 20px;
}

/* Player panels — one per player, stacked top-left. Each shows the balls that player
   still owes; the active player's panel is lit in their colour.
   GameplayUIController toggles player-panel--active and --pulse on turn change,
   and rebuilds the ball dots (player-panel-balls) from the rules state each turn. */
.player-panels {
    flex-direction: column;
}

.player-panel {
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 16px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.12);
    padding: 10px 16px;
    margin-bottom: 8px;
    opacity: 0.55;
    transition-property: opacity, border-color, scale;
    transition-duration: 0.15s;
}

.player-panel--active {
    opacity: 1;
}

.player-panel--p1.player-panel--active {
    border-color: rgb(245, 195, 65);
}

.player-panel--p2.player-panel--active {
    border-color: rgb(95, 170, 255);
}

.player-panel--pulse {
    scale: 1.06 1.06;
}

.player-panel-name {
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
}

.player-panel-balls {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

/* Shown instead of dots while no group is assigned to the player */
.player-panel-open {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 4px;
}

/* One remaining ball — dot uses the generated ball sprite, so solids, stripes and
   the numbered 8 read from the art itself. */
.ball-dot {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    margin: 3px 6px 0 0;
    -unity-background-scale-mode: scale-to-fit;
}

.ball-dot--1 { background-image: resource("Sprites/Ball_01"); }
.ball-dot--2 { background-image: resource("Sprites/Ball_02"); }
.ball-dot--3 { background-image: resource("Sprites/Ball_03"); }
.ball-dot--4 { background-image: resource("Sprites/Ball_04"); }
.ball-dot--5 { background-image: resource("Sprites/Ball_05"); }
.ball-dot--6 { background-image: resource("Sprites/Ball_06"); }
.ball-dot--7 { background-image: resource("Sprites/Ball_07"); }
.ball-dot--8 { background-image: resource("Sprites/Ball_08"); }
.ball-dot--9 { background-image: resource("Sprites/Ball_09"); }
.ball-dot--10 { background-image: resource("Sprites/Ball_10"); }
.ball-dot--11 { background-image: resource("Sprites/Ball_11"); }
.ball-dot--12 { background-image: resource("Sprites/Ball_12"); }
.ball-dot--13 { background-image: resource("Sprites/Ball_13"); }
.ball-dot--14 { background-image: resource("Sprites/Ball_14"); }
.ball-dot--15 { background-image: resource("Sprites/Ball_15"); }

/* ── Turn-change banner (absolute overlay) ───────────────────── */

.turn-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 36%;
    -unity-text-align: middle-center;
    font-size: 56px;
    -unity-font-style: bold;
    color: white;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.55);
    transition-property: opacity, scale;
    transition-duration: 0.35s;
}

.turn-banner--hidden {
    display: none;
}

/* Set when the banner should start dissolving out */
.turn-banner--fading {
    opacity: 0;
    scale: 1.15 1.15;
}

.turn-banner--p1 {
    color: rgb(245, 195, 65);
}

.turn-banner--p2 {
    color: rgb(95, 170, 255);
}

/* ── Denied-shoot hint (absolute overlay) ───────────────────── */

/* Shown when the player taps the shoot button while it is still red.
   GameplayUIController flashes it above the bottom bar and shakes the button. */
.shoot-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 132px;
    -unity-text-align: middle-center;
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.55);
    transition-property: opacity;
    transition-duration: 0.3s;
}

.shoot-hint--hidden {
    display: none;
}

/* Set when the hint should start dissolving out */
.shoot-hint--fading {
    opacity: 0;
}

/* ── Game-over overlay (absolute, full screen) ──────────────── */

/* Shown when a rule ends the match. GameplayUIController shows it with the
   winner's colour and hides the input HUD behind it. */
.game-over {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.game-over--hidden {
    display: none;
}

.game-over-panel {
    align-items: center;
    background-color: rgba(15, 15, 15, 0.85);
    border-radius: 24px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 40px 56px;
}

.game-over-title {
    font-size: 52px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
}

.game-over-title--p1 {
    color: rgb(245, 195, 65);
}

.game-over-title--p2 {
    color: rgb(95, 170, 255);
}

.game-over-buttons {
    flex-direction: row;
    margin-top: 28px;
}

.game-over-button {
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 32px;
    border-width: 3px;
    border-color: rgb(70, 200, 90);
    padding: 12px 32px;
    margin: 0 8px;
}

.game-over-button:hover {
    border-color: rgba(255, 255, 255, 0.6);
}

/* ── Compact spin button (always-visible cue ball) ──────────── */

.spin-button {
    width: 80px;
    height: 80px;
    border-radius: 40px;
    background-color: rgb(240, 240, 235);
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0.35);
    align-items: center;
    justify-content: center;
    -unity-overflow-clip-box: padding-box;
}

.spin-button:hover {
    background-color: rgb(255, 255, 250);
    border-color: rgba(0, 0, 0, 0.55);
    scale: 1.06 1.06;
}

/* Small dot showing current hit position inside the compact button */
.spin-button-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgba(30, 30, 30, 0.85);
    position: absolute;
}

/* ── Expanded spin panel overlay ────────────────────────────── */

.spin-panel {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: rgba(15, 15, 15, 0.82);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 16px;
    align-items: center;
}

.spin-panel--hidden {
    display: none;
}

/* Large interactive cue ball */
.spin-ball {
    width: 200px;
    height: 200px;
    border-radius: 100px;
    background-color: rgb(240, 240, 235);
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0.3);
    overflow: hidden;
}

/* Shine highlight — small off-centre ellipse */
.spin-ball-shine {
    position: absolute;
    width: 60px;
    height: 40px;
    border-radius: 30px;
    background-color: rgba(255, 255, 255, 0.55);
    top: 20px;
    left: 30px;
}

/* Draggable hit-point dot on the large ball */
.spin-hit-dot {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: rgba(20, 20, 20, 0.85);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.5);
    position: absolute;
}

/* "Hit Point" label below the ball */
.spin-panel-label {
    color: rgba(220, 220, 220, 0.9);
    font-size: 18px;
    margin-top: 10px;
    -unity-font-style: bold;
}

/* ── Bottom bar ─────────────────────────────────────────────── */

.bottom-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding: 20px;
}

.lock-toggles {
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.5);
    padding: 10px;
    border-radius: 10px;
}

/* Icon HUD buttons (aim/power locks + shoot) share one style: transparent square
   with a tinted glyph and border — green when unlocked, red plus a padlock badge
   while locked. GameplayUIController toggles hud-button--locked. */
.hud-button {
    width: 92px;
    height: 92px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(70, 200, 90);
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(70, 200, 90);
    margin: 2px;
}

.hud-button:hover {
    border-color: rgba(255, 255, 255, 0.6);
    scale: 1.06 1.06;
}

.hud-button--locked {
    border-color: rgb(235, 70, 60);
    -unity-background-image-tint-color: rgb(235, 70, 60);
}

.lock-badge {
    display: none;
    position: absolute;
    width: 34px;
    height: 34px;
    top: 4px;
    right: 4px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: resource("Sprites/Icon_Lock");
}

.hud-button--locked .lock-badge {
    display: flex;
}

/* Per-button glyphs */
.lock-button--aim {
    background-image: resource("Sprites/Icon_Aim");
}

.lock-button--power {
    background-image: resource("Sprites/Icon_Power");
}

.shoot-button {
    background-image: resource("Sprites/Icon_Shoot");
}

/* ── Cancel zone ────────────────────────────────────────────── */

/* Drop target for cancelling the current drag: releasing the pointer here discards
   aim/power. Shown only while a drag is active (InputManager toggles the hidden
   class); dim red at rest, lit while the pointer hovers it (cancel-zone--hot).
   picking-mode is Ignore, so presses over it still start a table drag. */
.cancel-zone {
    width: 92px;
    height: 92px;
    margin: 2px;
    border-radius: 46px;
    border-width: 2px;
    border-color: rgba(235, 70, 60, 0.35);
    background-color: rgba(235, 70, 60, 0.1);
    align-items: center;
    justify-content: center;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.12s;
}

.cancel-zone--hidden {
    display: none;
}

.cancel-zone--hot {
    border-color: rgba(235, 70, 60, 0.95);
    background-color: rgba(235, 70, 60, 0.3);
    scale: 1.08 1.08;
}

/* Two crossed bars instead of a ✕ glyph: font fallbacks render that glyph with an
   off-centre advance (varies per device), while these are centred by geometry.
   The 30px box is centred by .cancel-zone's flex; the bars sit at its middle. */
.cancel-zone-x {
    width: 30px;
    height: 30px;
}

.cancel-zone-x-bar {
    position: absolute;
    left: 13px;
    top: 0;
    width: 4px;
    height: 30px;
    border-radius: 2px;
    background-color: rgba(235, 70, 60, 0.55);
    rotate: 45deg;
}

.cancel-zone-x-bar--alt {
    rotate: -45deg;
}

