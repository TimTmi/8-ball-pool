# Unity .gitignore
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Note: .meta files must stay tracked. Unity stores asset GUIDs, import settings and
# component references in them, and losing one silently breaks every reference to that asset.

# ── Unity generated folders ───────────────────────────────────────────────────
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory captures can be huge and may contain sensitive data
/[Mm]emoryCaptures/

# Recordings can be huge
/[Rr]ecordings/

# Unity temp build tree (CMake/Gradle output for Android and other native targets)
/.utmp/

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# ── IDE and tooling ───────────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/

# Solution and project files are regenerated by Unity from the asset database
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ── Build output ──────────────────────────────────────────────────────────────
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressableAssetsData/*/*.bin*

# Temporary auto-generated Android assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ── Unity crash reports ───────────────────────────────────────────────────────
sysinfo.txt

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Agent-related files ───────────────────────────────────────────────────────
.agents/
.context-templates/
